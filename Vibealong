                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* Quick Actions */}
          <div className="grid grid-cols-2 gap-3">
            <button className="bg-gradient-to-r from-green-500 to-teal-500 text-white p-3 rounded-lg font-medium hover:shadow-lg transition-all">
              Add from Spotify
            </button>
            <button className="bg-gradient-to-r from-purple-500 to-blue-500 text-white p-3 rounded-lg font-medium hover:shadow-lg transition-all">
              Share Playlist
            </button>
          </div>
        </div>
      )}
    </div>
  );

  const ProfileTab = () => (
    <div className="space-y-6">
      {/* User Info */}
      <div className="bg-white rounded-xl p-6 shadow-sm">
        <div className="flex items-center space-x-4 mb-6">
          <div className="w-16 h-16 bg-gradient-to-br from-purple-500 to-blue-500 rounded-full flex items-center justify-center text-white text-xl font-bold">
            {currentUser.name.split(' ').map(n => n[0]).join('')}
          </div>
          <div>
            <h3 className="text-xl font-semibold">{currentUser.name}</h3>
            <p className="text-gray-600">{currentUser.email}</p>
            <div className="flex items-center space-x-4 mt-2 text-sm">
              <div className="flex items-center space-x-1">
                <Star className="w-4 h-4 text-yellow-400 fill-current" />
                <span>{currentUser.rating}</span>
              </div>
              <span className="text-gray-400">鈥�</span>
              <span>{currentUser.rides} rides</span>
            </div>
          </div>
        </div>

        <div className="grid grid-cols-2 gap-4 text-center">
          <div className="bg-gray-50 p-4 rounded-lg">
            <h4 className="font-semibold text-gray-800">Platform</h4>
            <p className="text-blue-600 font-medium">{currentUser.platform}</p>
          </div>
          <div className="bg-gray-50 p-4 rounded-lg">
            <h4 className="font-semibold text-gray-800">Member Since</h4>
            <p className="text-gray-600">Jan 2023</p>
          </div>
        </div>
      </div>

      {/* Settings */}
      <div className="bg-white rounded-xl p-4 shadow-sm">
        <h3 className="font-semibold mb-4">Settings</h3>
        <div className="space-y-3">
          <button className="w-full flex items-center justify-between p-3 hover:bg-gray-50 rounded-lg transition-colors">
            <div className="flex items-center space-x-3">
              <Settings className="w-5 h-5 text-gray-600" />
              <span>App Settings</span>
            </div>
            <span className="text-gray-400">鈥�</span>
          </button>
          <button className="w-full flex items-center justify-between p-3 hover:bg-gray-50 rounded-lg transition-colors">
            <div className="flex items-center space-x-3">
              <Volume2 className="w-5 h-5 text-gray-600" />
              <span>Music Preferences</span>
            </div>
            <span className="text-gray-400">鈥�</span>
          </button>
          <button 
            onClick={handleLogout}
            className="w-full flex items-center justify-between p-3 hover:bg-red-50 rounded-lg transition-colors text-red-600"
          >
            <div className="flex items-center space-x-3">
              <LogOut className="w-5 h-5" />
              <span>Sign Out</span>
            </div>
          </button>
        </div>
      </div>
    </div>
  );

  if (!currentUser) {
    return <LoginScreen />;
  }

  return (
    <div className="min-h-screen bg-gray-50">
      {/* Header */}
      <header className="bg-white shadow-sm p-4">
        <div className="flex items-center justify-between">
          <div className="flex items-center space-x-3">
            <div className="bg-gradient-to-r from-purple-500 to-blue-500 w-10 h-10 rounded-full flex items-center justify-center">
              <Music className="text-white text-lg" />
            </div>
            <h1 className="text-xl font-bold text-gray-800">RideBeats</h1>
          </div>
          <div className="text-right">
            <p className="font-medium text-gray-800">{currentUser.name}</p>
            <p className="text-sm text-gray-600">{currentUser.platform}</p>
          </div>
        </div>
      </header>

      {/* Content */}
      <main className="p-4 pb-20">
        {activeTab === 'ride' && <RideTab />}
        {activeTab === 'music' && <MusicTab />}
        {activeTab === 'profile' && <ProfileTab />}
      </main>

      {/* Bottom Navigation */}
      <nav className="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 p-4">
        <div className="flex justify-around">
          <button
            onClick={() => setActiveTab('ride')}
            className={`flex flex-col items-center space-y-1 ${
              activeTab === 'ride' ? 'text-blue-500' : 'text-gray-400'
            }`}
          >
            <Car className="w-6 h-6" />
            <span className="text-xs">Ride</span>
          </button>
          <button
            onClick={() => setActiveTab('music')}
            className={`flex flex-col items-center space-y-1 ${
              activeTab === 'music' ? 'text-blue-500' : 'text-gray-400'
            }`}
          >
            <Music className="w-6 h-6" />
            <span className="text-xs">Music</span>
          </button>
          <button
            onClick={() => setActiveTab('profile')}
            className={`flex flex-col items-center space-y-1 ${
              activeTab === 'profile' ? 'text-blue-500' : 'text-gray-400'
            }`}
          >
            <User className="w-6 h-6" />
            <span className="text-xs">Profile</span>
          </button>
        </div>
      </nav>
    </div>
  );
};

export default RideHailingApp;
